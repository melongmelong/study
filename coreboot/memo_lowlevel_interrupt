IDT실제 동작(Intel64 and IA-32 Architectures Software Developer's Manual, Volume 3, 6.12.1 내용) 확인해보기
  ramstage에서 테스트 수행함.
  아래 diff 반영하여 qemu monitor로 확인함!.
  int $0x00을 적절한 값으로 변경하면서 테스트하였음.
diff --git a/src/arch/x86/exception.c b/src/arch/x86/exception.c
index aecce7b7b1..9cab374cac 100644
--- a/src/arch/x86/exception.c
+++ b/src/arch/x86/exception.c
@@ -556,6 +556,21 @@ void x86_exception(struct eregs *info)
                else if ((uintptr_t)ptr == info->esp)
                        printk(BIOS_EMERG, " <-esp");
        }
// 인터럽트 발생시, 호출되는핸들러(x86_exception)에서 vector값을 eax레지스터에 넣고 hlt.(GP익셉션 발생 확인목적)
+       asm volatile (
+           "movl %0, %%eax;"  // info->vector 값을 eax로 이동
+           :
+           : "m" (info->vector)  // input: 구조체 멤버 메모리 주소
+           : "eax", "cc", "memory"  // clobber: eax 사용, 플래그 변경, 메모리 접근
+       );
+       asm volatile ("hlt\n");
+       
 
        die("\n");
 #endif
@@ -642,6 +657,8 @@ static void load_idt(void *table, size_t sz)
 
        if (ENV_RAMSTAGE)
                memcpy(&idtarg, &lidtarg, sizeof(idtarg));
//임의의 인터럽트를 소프트웨어적으로 발생시킴!
+       
+       asm volatile ("int $0x00\n");
 }
 
 asmlinkage void exception_init(void)
